# Copy to .env locally. Never commit actual values.
ASSISTANT_API_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional during rotation only:
# ASSISTANT_API_TOKEN_PREVIOUS=
ENTRA_TENANT_ID=REPLACE_WITH_DIRECTORY_TENANT_UUID
ENTRA_OWNER_OID=REPLACE_WITH_YOUR_USER_OBJECT_UUID_IN_THIS_TENANT
ENTRA_API_AUDIENCE=REPLACE_WITH_BACKEND_API_APPLICATION_UUID
ENTRA_SCOPE=access_as_user
ENTRA_SPA_CLIENT_ID=REPLACE_WITH_SOURCE_PAGE_APPLICATION_UUID
STORAGE_MODE=azure
STORAGE_ACCOUNT_URL=https://REPLACE.blob.core.windows.net
STORAGE_CONTAINER=assistant
# Optional user-assigned managed identity client UUID; omit for system identity.
# AZURE_CLIENT_ID=
PORT=8080
ENABLE_AUTH_PROBE=false
# Synthetic local smoke tests ONLY (data disappears at exit):
# STORAGE_MODE=memory
# ALLOW_INSECURE_LOCAL_DEV=true
# HOST=127.0.0.1
